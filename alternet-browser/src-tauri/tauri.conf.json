{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlterNet Browser",
  "identifier": "net.alternet.browser",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "bundle": {
    "active": false,
    "icon": []
  },
  "app": {
    "windows": [
      {
        "title": "AlterNet Browser",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://asset.localhost alter:; connect-src ipc: http://ipc.localhost alter:"
    }
  },
  "plugins": {
    "dialog": {},
    "shell": {},
    "updater": {
      "endpoints": [
        "https://github.com/alternet/alternet/releases/latest/download/latest.json"
      ]
    },
    "process": {
      "all": true
    }
  }
}
